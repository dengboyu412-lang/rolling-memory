# Build & Artifacts
bin/*
!bin/rolling-memory-*
dist/
dist-verify/
*.log
*.db
*.db-shm
*.db-wal
autoresearch-dashboard.html

# IDEs & System
.DS_Store
.zcode/

# Local environment, release receipts (self-referential HEAD SHA) & bytecode
/dev/release/receipts/
.env
.env.*
# Console web build configs carry only public values (ports, brand layer,
# loopback API URL) and are load-bearing: git-archive mirrors and source builds
# without them lose the frontend API base and send every request to the static
# server. Keep them tracked.
!admin/web/.env
!admin/web/.env.development
/AGENTS.md
/AGENT.md
/CLAUDE.md
/MEMORY.md
__pycache__/
*.pyc

# Upstream benchmark fetch output (`rmem eval --fetch`): upstream corpus files
# and the provenance record live in the user data directory; the dev machine's
# data dir is symlinked to this tree, so never commit them here.
/evaldata/*/raw_memory/
/evaldata/*/processed_memory/
/evaldata/*/atm-bench/
/evaldata/*/UPSTREAM-PROVENANCE.json

# Local build artifacts and ephemeral evaluation run state (regenerable,
# multi-GB in aggregate): compiled test binaries, perf probes built in place,
# and per-arm eval vaults used only for resume.
/*.test
/perfprobe
/dev/evidence/**/state/
